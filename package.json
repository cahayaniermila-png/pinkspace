{
  "name": "pinkspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate && node -e \"const fs=require('fs'),p='./node_modules/@prisma/client/runtime/';['mysql','postgresql'].forEach(d=>{try{fs.unlinkSync(p+'query_engine_bg.'+d+'.wasm')}catch(e){}try{fs.unlinkSync(p+'query_compiler_bg.'+d+'.wasm')}catch(e){}})\"",
    "dev": "next dev",
    "build": "next build",
    "pages:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && wrangler dev",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:migrate": "npx prisma migrate dev",
    "db:reset": "npx prisma migrate reset --force && npx tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@prisma/adapter-d1": "^6.4.1",
    "@prisma/client": "^6.4.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "^6.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "wrangler": "^4.118.0"
  }
}
